{
  "name": "azure-devops-wiki",
  "version": "0.1.1",
  "description": "Obsidian plugin: edit a git-cloned Azure DevOps wiki as a first-class vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-plugin": "node scripts/install-to-vault.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "verify-wiki": "esbuild scripts/verify-against-wiki.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-wiki.cjs --log-level=error && node node_modules/.cache/verify-wiki.cjs"
  },
  "keywords": [
    "obsidian",
    "azure-devops",
    "wiki"
  ],
  "author": "Vineet Khurana",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.3",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
